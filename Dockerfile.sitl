# INAV SITL runtime image.
#
# Separate from the top-level Dockerfile, which is the *firmware* build
# environment (inav-build). This one builds the host SITL binary and ships a
# small runtime image you can point at a simulator.
#
#   docker build -f Dockerfile.sitl -t inav-sitl:9.1 .
#   docker run --rm -it --network host inav-sitl:9.1 \
#       --sim=ue --simip=<HOST_IP> --simport=49000
#
# The image is self-contained: it carries the SITL binary, a *configured*
# eeprom to boot from, and the launcher that drives a whole fleet. The one
# thing it cannot carry is where the simulator is, so --simip (and which
# vehicles to start) is what the operator supplies -- see sitl.conf.example.
#
# entrypoint.sh seeds /data/eeprom.bin from eeprom.default.bin when it is
# missing. That default matters more than it looks: without it the SITL
# creates an all-zero eeprom, boots on factory defaults whose receiver_type
# is NONE, and then sits on ARMING_DISABLED_RC_LINK forever while the
# simulator link reports itself perfectly healthy.
#
# On WSL2 --network host makes the container share the WSL2 netns, so the
# Windows host is reachable at the default gateway and entrypoint.sh can
# still fill --simip in from there. On any other host that gateway is a
# router, not the simulator, so the fallback is refused instead of quietly
# black-holing every subscription.

# ---------- builder ----------
FROM ubuntu:22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        cmake \
        g++ \
        gcc \
        git \
        ninja-build \
        python3 \
        python3-yaml \
        ruby \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . .

# cmake/GetGitRevisionDescription.cmake wants a revision; without a .git the
# version string degrades to "GITDIR-N" (the real one is dockerignored). So
# synthesize a repository from the build context.
RUN git init -q . \
    && git config user.email "sitl@inav.invalid" \
    && git config user.name "inav sitl build" \
    && git add -A \
    && git commit -q -m "INAV SITL build context" \
    && cmake -S . -B build_SITL -GNinja -DSITL=ON -DCMAKE_BUILD_TYPE=RelWithDebInfo \
    && ninja -C build_SITL

# ---------- runtime ----------
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        iproute2 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 1000 inav \
    && mkdir -p /data \
    && chown inav:inav /data

COPY --from=builder /src/build_SITL/inav_*_SITL /opt/inav/
COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
COPY docker/eeprom.default.bin /opt/inav/eeprom.default.bin
COPY docker/eeprom.msp.bin /opt/inav/eeprom.msp.bin
COPY docker/launch_sitl.sh /opt/inav/launch_sitl.sh
COPY docker/sitl.conf.example /opt/inav/sitl.conf.example

# Both eeproms stay root-owned and read-only on purpose: they are only ever the
# *source* of a copy, never the live eeprom. The firmware opens the eeprom "r+",
# and a read-only eeprom is not a degraded mode -- the failed open is not
# checked before the fwrite, so it is a SIGSEGV with no ports bound.
#
# But cp() creates the destination with the *source's* mode, which makes this
# 0444 a live grenade: the seeded /data/eeprom.bin comes out read-only too and
# hangs the firmware on the very first boot. entrypoint.sh chmods the copy
# back. If you ever change how that copy is made, keep the chmod.
#
# eeprom.msp.bin is the same config with receiver_type = MSP instead of SIM, so
# the RC comes from an MSP client on the TCP port rather than from the
# simulator's datarefs. Nothing else differs; see make_msp_eeprom.py, which
# derives it and checks the checksum it has to recompute.
#
# Which of the two gets seeded is chosen at run time by RECEIVER=sim|msp (or
# SIM=msp, which entrypoint.sh translates to the same thing). Both files are
# baked in precisely so neither choice needs a file from the host.
#
# Explicit modes rather than +x because building from the Windows tree mounts
# the context through 9p, which reports every file as 777 -- so the image
# differs depending on which tree you built it from unless it is pinned here.
RUN chmod 0755 /usr/local/bin/entrypoint.sh /opt/inav/launch_sitl.sh \
    && chmod 0644 /opt/inav/sitl.conf.example \
    && chmod 0444 /opt/inav/eeprom.default.bin /opt/inav/eeprom.msp.bin

USER inav
WORKDIR /data

# 5760-5767: MSP/UART TCP sockets (Configurator), 49000/udp: simulator link
EXPOSE 5760-5767/tcp
EXPOSE 49000/udp

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
